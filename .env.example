# Copy to .env and fill in. NEVER commit the real file — .gitignore excludes it.
#
# Mint a key at https://1xai.ir/dashboard . New accounts get free credit from
# the signup wheel at https://1xai.ir/free .

# Preferred: unambiguous, and leaves OPENAI_API_KEY free for real OpenAI use.
ONEXAI_API_KEY=1xai-replace-me

# Both SDKs fall back to this, and most third-party tools read it directly.
# OPENAI_API_KEY=1xai-replace-me
# OPENAI_BASE_URL=https://1xai.ir/v1
# OPENAI_API_BASE=https://1xai.ir/v1        # older tools use this name

# Native passthroughs (only if you need vendor-specific features).
# ANTHROPIC_BASE_URL=https://1xai.ir/anthropic
# ANTHROPIC_AUTH_TOKEN=1xai-replace-me
